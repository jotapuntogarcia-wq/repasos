                    correct: "couldn't",
                    options: ["couldn't", "could", "had to"]
                };
            } else {
                return {
                    question: `My grandad is very clever. When he was five, he ________ write perfectly!`,
                    correct: "could",
                    options: ["could", "couldn't", "didn't have to"]
