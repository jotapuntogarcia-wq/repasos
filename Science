<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Science Explorer Quest 🚀 - 5.º Primaria</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&display=swap');
        body {
            font-family: 'Fredoka', sans-serif;
            background: linear-gradient(135deg, #e0f2fe 0%, #f0fdf4 100%);
        }
        .card-shadow {
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between text-slate-800 p-4 md:p-6">

    <!-- Header / Navbar -->
    <header class="max-w-3xl mx-auto w-full flex items-center justify-between bg-white px-6 py-4 rounded-2xl shadow-md mb-6 border-b-4 border-emerald-400">
        <div class="flex items-center gap-3">
            <div class="bg-emerald-500 text-white p-3 rounded-xl flex items-center justify-center text-xl font-bold shadow-sm">
                🔬
            </div>
            <div>
                <h1 class="text-xl md:text-2xl font-bold text-slate-800 leading-tight">Science Quest 🚀</h1>
                <p class="text-xs text-emerald-600 font-semibold">Professor Nova's Lab - 5.º Primaria</p>
            </div>
        </div>
        <div class="flex items-center gap-4">
            <div class="bg-amber-100 text-amber-800 px-3 py-1.5 rounded-full font-bold text-sm flex items-center gap-1.5 shadow-inner">
                <i class="fa-solid fa-star text-amber-500"></i>
                <span id="score-display">0 XP</span>
            </div>
        </div>
    </header>

    <!-- Main App Container -->
    <main class="max-w-3xl mx-auto w-full flex-1 flex flex-col justify-center">

        <!-- START SCREEN -->
        <div id="start-screen" class="bg-white rounded-3xl p-6 md:p-10 card-shadow text-center border-b-8 border-indigo-500">
            <div class="text-6xl mb-4 animate-bounce">🌱 🔬 🦁</div>
            <h2 class="text-2xl md:text-3xl font-bold text-indigo-900 mb-3">¡Bienvenido a la Misión de Ciencia!</h2>
            <p class="text-slate-600 text-base md:text-lg mb-6 max-w-lg mx-auto">
                Repasa el tema de <b>Living Things</b> y <b>Plant Kingdom</b>. Demuestra todo lo que sabes, gana experiencia y ¡conviértete en un Supercientífico!
            </p>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8 text-left">
                <div class="bg-emerald-50 p-4 rounded-xl border border-emerald-200">
                    <div class="font-bold text-emerald-800 mb-1">🟢 Nivel 1</div>
                    <div class="text-xs text-emerald-600">Preguntas básicas de vocabulario y conceptos clave.</div>
                </div>
                <div class="bg-amber-50 p-4 rounded-xl border border-amber-200">
                    <div class="font-bold text-amber-800 mb-1">🟡 Nivel 2</div>
                    <div class="text-xs text-amber-600">Clasificación de reinos y partes de las plantas.</div>
                </div>
                <div class="bg-rose-50 p-4 rounded-xl border border-rose-200">
                    <div class="font-bold text-rose-800 mb-1">🔴 Nivel 3</div>
                    <div class="text-xs text-rose-600">Preguntas reto tipo examen para sacar un 10.</div>
                </div>
            </div>

            <button onclick="quizApp.startQuiz()" class="w-full md:w-auto px-8 py-4 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xl rounded-2xl shadow-lg transition-transform active:scale-95 flex items-center justify-center gap-3 mx-auto">
                <i class="fa-solid fa-play"></i> ¡Comenzar el Reto!
            </button>
        </div>

        <!-- QUIZ SCREEN -->
        <div id="quiz-screen" class="hidden bg-white rounded-3xl p-6 md:p-8 card-shadow border-b-8 border-indigo-500 flex flex-col justify-between">
            
            <!-- Progress Bar & Level -->
            <div>
                <div class="flex justify-between items-center mb-3">
                    <span id="level-badge" class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider"></span>
                    <span id="question-tracker" class="text-sm font-semibold text-slate-500"></span>
                </div>
                <div class="w-full bg-slate-100 h-3 rounded-full overflow-hidden mb-6">
                    <div id="progress-bar" class="bg-indigo-500 h-full transition-all duration-300 w-0"></div>
                </div>

                <!-- Question Text -->
                <div class="mb-6">
                    <h3 id="question-text" class="text-lg md:text-xl font-bold text-slate-800 mb-2"></h3>
                    <p id="question-translation" class="text-sm text-slate-500 italic"></p>
                </div>

                <!-- Options -->
                <div id="options-container" class="grid grid-cols-1 gap-3 mb-6"></div>

                <!-- Feedback Box -->
                <div id="feedback-box" class="hidden p-4 rounded-2xl mb-4 transition-all">
                    <div class="flex items-start gap-3">
                        <div id="feedback-icon" class="text-2xl mt-0.5"></div>
                        <div>
                            <div id="feedback-title" class="font-bold text-base"></div>
                            <div id="feedback-desc" class="text-sm mt-1"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer / Next Button -->
            <div class="flex justify-end pt-2">
                <button id="next-btn" onclick="quizApp.nextQuestion()" class="hidden px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-md flex items-center gap-2 transition-transform active:scale-95">
                    <span>Siguiente</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>
        </div>

        <!-- RESULTS SCREEN -->
        <div id="results-screen" class="hidden bg-white rounded-3xl p-6 md:p-10 card-shadow text-center border-b-8 border-emerald-500">
            <div id="result-emoji" class="text-7xl mb-4">🏆</div>
            <h2 id="result-title" class="text-3xl font-bold text-slate-800 mb-2"></h2>
            <p id="result-subtitle" class="text-slate-600 mb-6 text-base md:text-lg"></p>

            <div class="bg-slate-50 p-6 rounded-2xl mb-8 flex justify-around items-center border border-slate-200">
                <div class="text-center">
                    <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Puntuación</div>
                    <div id="final-score" class="text-3xl font-extrabold text-indigo-600">0/10</div>
                </div>
                <div class="h-10 w-px bg-slate-200"></div>
                <div class="text-center">
                    <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">XP Ganados</div>
                    <div id="final-xp" class="text-3xl font-extrabold text-amber-500">+0 XP</div>
                </div>
            </div>

            <button onclick="quizApp.resetQuiz()" class="px-8 py-4 bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-lg rounded-2xl shadow-lg transition-transform active:scale-95 flex items-center justify-center gap-3 mx-auto">
                <i class="fa-solid fa-rotate-right"></i> Volver a Jugar
            </button>
        </div>

    </main>

    <!-- Footer -->
    <footer class="max-w-3xl mx-auto w-full text-center text-xs text-slate-400 py-4">
        Natural Science 5.º Primary School • Practice App
    </footer>

    <!-- Application Script -->
    <script>
        const questionsData = [
            // LEVEL 1
            {
                level: 1,
                question: "What are the three vital functions of all living beings?",
                translation: "(¿Cuáles son las tres funciones vitales de todos los seres vivos?)",
                options: [
                    { text: "Eating, sleeping and running", isCorrect: false },
                    { text: "Nutrition, Interaction and Reproduction", isCorrect: true },
                    { text: "Photosynthesis, respiration and absorption", isCorrect: false }
                ],
                explanation: "Las tres funciones vitales son **Nutrition** (nutrición), **Interaction** (relación) y **Reproduction** (reproducción)."
            },
            {
                level: 1,
                question: "Which kingdom includes unicellular prokaryotic organisms like bacteria?",
                translation: "(¿Qué reino incluye organismos unicelulares procariotas como las bacterias?)",
                options: [
                    { text: "Fungi kingdom", isCorrect: false },
                    { text: "Protists kingdom", isCorrect: false },
                    { text: "Monera kingdom", isCorrect: true }
                ],
                explanation: "El reino **Monera** contiene bacterias y cianobacterias, que son células procariotas sin núcleo."
            },
            {
                level: 1,
                question: "Which part of the plant absorbs water and minerals from the soil?",
                translation: "(¿Qué parte de la planta absorbe agua y minerales del suelo?)",
                options: [
                    { text: "Roots (Root hairs)", isCorrect: true },
                    { text: "Leaves (Stomata)", isCorrect: false },
                    { text: "Stem (Trunk)", isCorrect: false }
                ],
                explanation: "Las **roots** (raíces) y sus pelos absorbentes (**root hairs**) absorben agua y minerales del suelo."
            },
            // LEVEL 2
            {
                level: 2,
                question: "Why are mushrooms in the Fungi kingdom and not in the Plantae kingdom?",
                translation: "(¿Por qué las setas están en el reino Fungi y no en Plantae?)",
                options: [
                    { text: "Because they perform photosynthesis using sunlight", isCorrect: false },
                    { text: "Because they have heterotrophic nutrition and cannot make their own food", isCorrect: true },
                    { text: "Because they are unicellular prokaryotic organisms", isCorrect: false }
                ],
                explanation: "Los hongos tienen nutrición **heterótrofa** (no hacen fotosíntesis); absorben nutrientes de restos de seres vivos."
            },
            {
                level: 2,
                question: "Where are stomata located on a leaf and what is their function?",
                translation: "(¿Dónde se ubican los estomas y cuál es su función?)",
                options: [
                    { text: "On the upper side to absorb maximum sunlight", isCorrect: false },
                    { text: "On the lower side to exchange gases like oxygen and carbon dioxide", isCorrect: true },
                    { text: "Inside the stem to transport water and sap", isCorrect: false }
                ],
                explanation: "Los **stomata** (estomas) están en el envés (**lower side**) de la hoja y permiten el intercambio de gases."
            },
            {
                level: 2,
                question: "Which non-seed plant group has vessels and flexible stems, but NO flowers?",
                translation: "(¿Qué grupo de plantas sin semillas tiene vasos y tallo flexible, pero NO flores?)",
                options: [
                    { text: "Mosses", isCorrect: false },
                    { text: "Ferns", isCorrect: true },
                    { text: "Gymnosperms", isCorrect: false }
                ],
                explanation: "Los **ferns** (helechos) tienen raíz, tallo flexible y vasos conductores, pero se reproducen por esporas sin tener flores."
            },
            {
                level: 2,
                question: "What gas do plant leaves absorb from the air during nutrition?",
                translation: "(¿Qué gas absorben las hojas del aire durante la nutrición?)",
                options: [
                    { text: "Carbon dioxide", isCorrect: true },
                    { text: "Oxygen", isCorrect: false },
                    { text: "Nitrogen", isCorrect: false }
                ],
                explanation: "Las plantas absorben **carbon dioxide** (dióxido de carbono) para realizar la fotosíntesis y liberar **oxygen** (oxígeno)."
            },
            // LEVEL 3
            {
                level: 3,
                question: "What is the main difference between Gymnosperms and Angiosperms?",
                translation: "(¿Cuál es la diferencia principal entre Gimnospermas y Angiospermas?)",
                options: [
                    { text: "Gymnosperms have seeds inside fruits; Angiosperms do not", isCorrect: false },
                    { text: "Gymnosperms have seeds in cones; Angiosperms have flowers and seeds inside fruits", isCorrect: true },
                    { text: "Gymnosperms reproduce by spores; Angiosperms reproduce by seeds", isCorrect: false }
                ],
                explanation: "Las **gymnosperms** (como los pinos) tienen semillas en piñas (**cones**). Las **angiosperms** tienen flores vistosas y fruto (**fruit**)."
            },
            {
                level: 3,
                question: "What steps take place during the Interaction function when an animal responds to a stimulus?",
                translation: "(¿Qué pasos ocurren en la función de relación cuando un animal responde a un estímulo?)",
                options: [
                    { text: "Receive information -> Process information -> Respond using muscles/glands", isCorrect: true },
                    { text: "Obtain nutrients -> Use substances -> Eliminate waste", isCorrect: false },
                    { text: "Asexual reproduction -> Gamete formation -> Offspring production", isCorrect: false }
                ],
                explanation: "La función de relación pasa por: **Receive** (sentidos) ➡️ **Process** (sistema nervioso) ➡️ **Respond** (músculos/glándulas)."
            },
            {
                level: 3,
                question: "Which kingdom contains multicellular organisms with eukaryotic cells that DO NOT have a cell wall?",
                translation: "(¿Qué reino contiene organismos pluricelulares eucariotas que NO tienen pared celular?)",
                options: [
                    { text: "Plantae", isCorrect: false },
                    { text: "Fungi", isCorrect: false },
                    { text: "Animalia", isCorrect: true }
                ],
                explanation: "Las células del reino **Animalia** son eucariotas pero **sin pared celular**, a diferencia de plantas y hongos."
            }
        ];

        class QuizApp {
            constructor() {
                this.currentQuestionIndex = 0;
                this.score = 0;
                this.xp = 0;
                this.selectedOption = null;

                // Elements
                this.startScreen = document.getElementById('start-screen');
                this.quizScreen = document.getElementById('quiz-screen');
                this.resultsScreen = document.getElementById('results-screen');

                this.levelBadge = document.getElementById('level-badge');
                this.questionTracker = document.getElementById('question-tracker');
                this.progressBar = document.getElementById('progress-bar');
                this.questionText = document.getElementById('question-text');
                this.questionTranslation = document.getElementById('question-translation');
                this.optionsContainer = document.getElementById('options-container');
                
                this.feedbackBox = document.getElementById('feedback-box');
                this.feedbackIcon = document.getElementById('feedback-icon');
                this.feedbackTitle = document.getElementById('feedback-title');
                this.feedbackDesc = document.getElementById('feedback-desc');
                
                this.nextBtn = document.getElementById('next-btn');
                this.scoreDisplay = document.getElementById('score-display');
            }

            startQuiz() {
                this.currentQuestionIndex = 0;
                this.score = 0;
                this.xp = 0;
                this.scoreDisplay.innerText = "0 XP";

                this.startScreen.classList.add('hidden');
                this.resultsScreen.classList.add('hidden');
                this.quizScreen.classList.remove('hidden');

                this.loadQuestion();
            }

            loadQuestion() {
                const q = questionsData[this.currentQuestionIndex];
                this.selectedOption = null;

                // Update Progress
                const progressPercent = ((this.currentQuestionIndex + 1) / questionsData.length) * 100;
                this.progressBar.style.width = `${progressPercent}%`;
                this.questionTracker.innerText = `Pregunta ${this.currentQuestionIndex + 1} de ${questionsData.length}`;

                // Level Badge
                if (q.level === 1) {
                    this.levelBadge.innerText = "Nivel 1 - Principiante 🟢";
                    this.levelBadge.className = "px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800";
                } else if (q.level === 2) {
                    this.levelBadge.innerText = "Nivel 2 - Intermedio 🟡";
                    this.levelBadge.className = "px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-800";
                } else {
                    this.levelBadge.innerText = "Nivel 3 - Superinvestigador 🔴";
                    this.levelBadge.className = "px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-100 text-rose-800";
                }

                // Question texts
                this.questionText.innerText = q.question;
                this.questionTranslation.innerText = q.translation;

                // Reset Feedback & Next Button
                this.feedbackBox.classList.add('hidden');
                this.nextBtn.classList.add('hidden');

                // Load Options
                this.optionsContainer.innerHTML = '';
                q.options.forEach((opt, idx) => {
                    const btn = document.createElement('button');
                    btn.className = "w-full text-left p-4 rounded-xl border-2 border-slate-200 hover:border-indigo-400 bg-white hover:bg-indigo-50 font-medium text-slate-700 transition-all flex items-center justify-between group cursor-pointer shadow-sm";
                    btn.innerHTML = `
                        <span>${opt.text}</span>
                        <div class="w-6 h-6 rounded-full border-2 border-slate-300 group-hover:border-indigo-500 flex items-center justify-center text-xs text-white"></div>
                    `;
                    btn.onclick = () => this.selectOption(idx, opt.isCorrect, btn);
                    this.optionsContainer.appendChild(btn);
                });
            }

            selectOption(selectedIndex, isCorrect, btnElement) {
                if (this.selectedOption !== null) return; // Prevent multiple clicks
                this.selectedOption = selectedIndex;

                const q = questionsData[this.currentQuestionIndex];
                const optionButtons = this.optionsContainer.children;

                // Disable all buttons
                for (let btn of optionButtons) {
                    btn.classList.remove('hover:border-indigo-400', 'hover:bg-indigo-50', 'cursor-pointer');
                    btn.disabled = true;
                }

                // Apply styling based on answer
                if (isCorrect) {
                    btnElement.className = "w-full text-left p-4 rounded-xl border-2 border-emerald-500 bg-emerald-50 font-medium text-emerald-900 transition-all flex items-center justify-between shadow-sm";
                    btnElement.querySelector('div').className = "w-6 h-6 rounded-full bg-emerald-500 flex items-center justify-center text-xs text-white";
                    btnElement.querySelector('div').innerHTML = '<i class="fa-solid fa-check"></i>';

                    this.score++;
                    const earnedXp = q.level * 10;
                    this.xp += earnedXp;
                    this.scoreDisplay.innerText = `${this.xp} XP`;

                    // Show positive feedback
                    this.feedbackBox.className = "p-4 rounded-2xl mb-4 bg-emerald-100 text-emerald-900 border border-emerald-300 block";
                    this.feedbackIcon.innerHTML = "🎉";
                    this.feedbackTitle.innerText = "¡Excelente respuesta!";
                    this.feedbackDesc.innerHTML = q.explanation;

                    // Trigger small confetti
                    confetti({ particleCount: 30, spread: 60, origin: { y: 0.8 } });

                } else {
                    btnElement.className = "w-full text-left p-4 rounded-xl border-2 border-rose-400 bg-rose-50 font-medium text-rose-900 transition-all flex items-center justify-between shadow-sm";
                    btnElement.querySelector('div').className = "w-6 h-6 rounded-full bg-rose-500 flex items-center justify-center text-xs text-white";
                    btnElement.querySelector('div').innerHTML = '<i class="fa-solid fa-xmark"></i>';

                    // Highlight correct answer
                    q.options.forEach((opt, idx) => {
                        if (opt.isCorrect) {
                            const correctBtn = optionButtons[idx];
                            correctBtn.className = "w-full text-left p-4 rounded-xl border-2 border-emerald-500 bg-emerald-50 font-medium text-emerald-900 transition-all flex items-center justify-between shadow-sm";
                            correctBtn.querySelector('div').className = "w-6 h-6 rounded-full bg-emerald-500 flex items-center justify-center text-xs text-white";
                            correctBtn.querySelector('div').innerHTML = '<i class="fa-solid fa-check"></i>';
                        }
                    });

                    // Show explanation feedback
                    this.feedbackBox.className = "p-4 rounded-2xl mb-4 bg-amber-50 text-amber-900 border border-amber-300 block";
                    this.feedbackIcon.innerHTML = "💡";
                    this.feedbackTitle.innerText = "¡Casi! Repasemos el concepto:";
                    this.feedbackDesc.innerHTML = q.explanation;
                }

                this.nextBtn.classList.remove('hidden');
            }

            nextQuestion() {
                this.currentQuestionIndex++;
                if (this.currentQuestionIndex < questionsData.length) {
                    this.loadQuestion();
                } else {
                    this.showResults();
                }
            }

            showResults() {
                this.quizScreen.classList.add('hidden');
                this.resultsScreen.classList.remove('hidden');

                document.getElementById('final-score').innerText = `${this.score}/${questionsData.length}`;
                document.getElementById('final-xp').innerText = `+${this.xp} XP`;

                const emojiEl = document.getElementById('result-emoji');
                const titleEl = document.getElementById('result-title');
                const subtitleEl = document.getElementById('result-subtitle');

                if (this.score === questionsData.length) {
                    emojiEl.innerText = "🏆";
                    titleEl.innerText = "¡Puntuación Perfecta!";
                    subtitleEl.innerText = "¡Increíble! Has demostrado ser un auténtico Maestro Científico.";
                    confetti({ particleCount: 100, spread: 100, origin: { y: 0.6 } });
                } else if (this.score >= 7) {
                    emojiEl.innerText = "🌟";
                    titleEl.innerText = "¡Buen trabajo!";
                    subtitleEl.innerText = "Tienes un gran dominio de Living Things y Plant Kingdom.";
                    confetti({ particleCount: 50, spread: 80, origin: { y: 0.6 } });
                } else {
                    emojiEl.innerText = "📘";
                    titleEl.innerText = "¡Buen intento!";
                    subtitleEl.innerText = "Repasa un poco los conceptos clave y vuelve a intentarlo para superar tu marca.";
                }
            }

            resetQuiz() {
                this.startQuiz();
            }
        }

        // Initialize App
        const quizApp = new QuizApp();
    </script>
</body>
</html>
